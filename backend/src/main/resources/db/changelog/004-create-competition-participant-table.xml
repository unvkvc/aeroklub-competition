<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation=" http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
            id="004-create-competition-participant-table"
            author="una">

        <createTable tableName="competition_participant">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="competition_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="competitor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column
                    name="created_at"
                    type="DATETIME"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_participant_competition"
                baseTableName="competition_participant"
                baseColumnNames="competition_id"
                referencedTableName="competition"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_participant_competitor"
                baseTableName="competition_participant"
                baseColumnNames="competitor_id"
                referencedTableName="competitor"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <addUniqueConstraint
                constraintName="uk_competition_competitor"
                tableName="competition_participant"
                columnNames="competition_id, competitor_id"/>

        <createIndex
                indexName="idx_participant_competitor"
                tableName="competition_participant">

            <column name="competitor_id"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>